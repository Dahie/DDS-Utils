<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE column-panel SYSTEM "sierra.dtd">

<column-panel padding="0" opaque="true" background="white">
    <row-panel spacing="8" weight="1">
        <scroll-pane weight="1">
            <buffered-image-canvas name="bufferedImageCanvas" />
        </scroll-pane>
    </row-panel>

    <row-panel padding="0" spacing="8">
        <button name="button" text="executeTask"/>
        <spacer weight="1"/>
        <label name="lblFile" foreground="gray"/>
    </row-panel>
</column-panel>